DATABASE_URL=postgresql://postgres:postgres@localhost:5432/friday
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PORT=3000

# Redis（BullMQ 队列 + Pub/Sub）；与 docker-compose 中 redis 服务一致
REDIS_URL=redis://localhost:6379

# LangChain / OpenAI 兼容接口（Worker 进程读取；勿提交真实密钥）
OPENAI_API_KEY=
# 可选：Azure/自建兼容网关，例如 https://api.openai.com/v1
OPENAI_BASE_URL=

# 仅本地开发可设为 true，由 TypeORM 根据实体同步表结构；生产务必 false
DATABASE_SYNC=true
